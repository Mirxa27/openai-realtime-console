{
  "name": "newomen",
  "version": "1.0.0",
  "description": "AI conversational platform for women's personal growth",
  "type": "module",
  "scripts": {
    "dev": "nodemon server.js --dev",
    "start": "node server.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client --ssrManifest",
    "build:server": "vite build --outDir dist/server --ssr /index.js",
    "devinstall": "zx ../../devinstall.mjs -- node server.js --dev",
    "lint": "eslint . --ext .js,.jsx --fix",
    "mobile:build": "npm run build && npx cap sync",
    "mobile:run:ios": "npx cap run ios",
    "mobile:run:android": "npx cap run android"
  },
  "dependencies": {
    "openai": "^4.28.0",
    "@supabase/supabase-js": "^2.39.0",
    "@supabase/auth-helpers-react": "^0.4.2",
    "@capacitor/core": "^5.0.0",
    "@capacitor/ios": "^5.0.0",
    "@capacitor/android": "^5.0.0",
    "@capacitor/cli": "^5.0.0",
    "framer-motion": "^10.16.0",
    "react-hook-form": "^7.48.0",
    "react-query": "^3.39.0",
    "zustand": "^4.4.0",
    "react-hot-toast": "^2.4.0",
    "lucide-react": "^0.294.0",
    "react-circular-progressbar": "^2.1.0",
    "react-spring": "^9.7.0",
    "react-use-gesture": "^9.1.3",
    "react-intersection-observer": "^9.5.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "history": "^5.3.0",
    "minipass": "^7.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-feather": "^2.0.10",
    "react-router-dom": "^6.20.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "nodemon": "^3.1.10",
    "postcss": "^8.4.31",
    "postcss-nesting": "^12.0.2",
    "postcss-preset-env": "^7.7.1",
    "tailwindcss": "^3.4.1",
    "vite": "^5.0.2",
    "autoprefixer": "^10.4.16"
  }
}
